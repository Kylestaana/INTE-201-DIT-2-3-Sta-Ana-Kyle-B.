public class Control_Flow_Part_2_Advanced {
public static void main(String[] args) {
        System.out.println("--- PATTERN GENERATOR WITH EARLY EXIT ---");
        
        int size = 5;

        // Outer loop representing rows
        for (int i = 1; i <= size; i++) {
            
            // DEMONSTRATES CONTINUE: Skip row 3 entirely
            if (i == 3) {
                System.out.println("Row " + i + ": [Skipped using continue]");
                continue; // Skips the rest of this iteration of the outer loop
            }

            System.out.print("Row " + i + ": ");

            // Inner loop representing columns
            for (int j = 1; j <= size; j++) {
                
                // DEMONSTRATES BREAK: Stop printing stars early once column exceeds the current row number 
                // (or if j reaches 4) to shape the triangle and demonstrate break.
                if (j > i || j > 4) {
                    break; // Exits the inner loop immediately
                }

                System.out.print("* ");
            }
            
            // Move to the next line after completing row printing
            System.out.println();
        }
    }
}
