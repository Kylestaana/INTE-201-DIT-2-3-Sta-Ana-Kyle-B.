package com.mycompany.control_flow_part_1;
    
public class Control_Flow_Part_1_Expert {
    public static void main(String[] args) {
        
        // Input variables for the transaction attempt
        String enteredUsername = "user123";
        int enteredPin = 4321;
        double accountBalance = 1250.00;
        double requestedWithdrawal = 300.00;

        // Correct credentials for validation
        String validUsername = "user123";
        int validPin = 4321;

        // Flags to track authorization stages
        boolean isAuthenticated = false;
        String tier = "";
        double dailyLimit = 0.0;
        boolean isWithdrawalValid = false;
        double feePercentage = 0.0;
        String denialReason = "";

        System.out.println("--- ATM TRANSACTION SYSTEM ---");
        System.out.println("Attempting withdrawal of: $" + requestedWithdrawal);

        // ==========================================
        // REQUIREMENT 1: Nested if for Username & PIN
        // ==========================================
        if (enteredUsername.equals(validUsername)) {
            if (enteredPin == validPin) {
                isAuthenticated = true;
            } else {
                denialReason = "Authentication Failed: Incorrect PIN.";
            }
        } else {
            denialReason = "Authentication Failed: Username not found.";
        }

        // Proceed only if authentication passed
        if (isAuthenticated) {
            
            // ==========================================
            // REQUIREMENT 2: Else-if ladder for Account Tier
            // ==========================================
            if (accountBalance >= 5000.0) {
                tier = "Platinum";
            } else if (accountBalance >= 2500.0) {
                tier = "Gold";
            } else if (accountBalance >= 1000.0) {
                tier = "Silver";
            } else {
                tier = "Bronze";
            }
            System.out.println("Account Tier Assigned: " + tier);

            // ==========================================
            // REQUIREMENT 3: Nested if for Withdrawal Logic (Balance & Limit)
            // ==========================================
            // Set tier-dependent daily limit
            switch (tier) {
                case "Platinum": dailyLimit = 2000.00; break;
                case "Gold":     dailyLimit = 1000.00; break;
                case "Silver":   dailyLimit = 500.00;  break;
                case "Bronze":   dailyLimit = 200.00;  break;
                default:         dailyLimit = 100.00;  break;
            }

            if (requestedWithdrawal <= accountBalance) {
                if (requestedWithdrawal <= dailyLimit) {
                    isWithdrawalValid = true;
                } else {
                    denialReason = "Denied: Requested amount exceeds your tier's daily limit ($" + dailyLimit + ").";
                }
            } else {
                denialReason = "Denied: Insufficient account balance.";
            }

            // ==========================================
            // REQUIREMENT 4: Switch for Transaction Fee & Final Decision
            // ==========================================
            switch (tier) {
                case "Platinum": feePercentage = 0.0;  break; // 0% fee
                case "Gold":     feePercentage = 0.01; break; // 1% fee
                case "Silver":   feePercentage = 0.02; break; // 2% fee
                case "Bronze":   feePercentage = 0.03; break; // 3% fee
            }

            // Combine everything to APPROVE or DENY
            if (isWithdrawalValid) {
                double feeAmount = requestedWithdrawal * feePercentage;
                double totalDeduction = requestedWithdrawal + feeAmount;
                
                // Final check to ensure balance covers withdrawal + fee
                if (totalDeduction <= accountBalance) {
                    System.out.println("Status: APPROVED");
                    System.out.println("Transaction Fee (" + (feePercentage * 100) + "%): $" + feeAmount);
                    System.out.println("Total Deducted: $" + totalDeduction);
                    System.out.println("Remaining Balance: $" + (accountBalance - totalDeduction));
                } else {
                    System.out.println("Status: DENIED");
                    System.out.println("Reason: Insufficient funds to cover withdrawal plus the " + tier + " tier transaction fee.");
                }
            } else {
                System.out.println("Status: DENIED");
                System.out.println("Reason: " + denialReason);
            }

        } else {
            // Print exact reason for authentication denial
            System.out.println("Status: DENIED");
            System.out.println("Reason: " + denialReason);
        }
    }
}
