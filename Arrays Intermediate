package com.mycompany.arrays;

/**
 *
 * @author kyles
 */
public class Arrays_Intermediate {
    public static void main(String[] args) {
        System.out.println("--- CLASS STATISTICS CALCULATOR ---");

        // 1. Declare an int array of at least 8 student scores[cite: 13]
        int[] scores = {85, 92, 78, 63, 95, 88, 70, 91};

        int sum = 0;
        int highest = scores[0];
        int lowest = scores[0];

        // 2. Using loops, compute the sum, highest score, and lowest score[cite: 13]
        for (int i = 0; i < scores.length; i++) {
            sum += scores[i];

            if (scores[i] > highest) {
                highest = scores[i];
            }

            if (scores[i] < lowest) {
                lowest = scores[i];
            }
        }

        // Compute average score (cast sum to double for decimal precision)
        double average = (double) sum / scores.length;

        // 3. Print all four statistics with clear labels[cite: 13]
        System.out.println("Total Students: " + scores.length);
        System.out.println("Sum Score:      " + sum);
        System.out.println("Average Score:  " + average);
        System.out.println("Highest Score:  " + highest);
        System.out.println("Lowest Score:   " + lowest);
    }
}
